#!/bin/sh
# MCP Gateway Unified Go CLI Wrapper
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT_DIR=$(CDPATH= cd -- "${SCRIPT_DIR}/.." && pwd)

if [ -x "${SCRIPT_DIR}/mcp-gateway-adapter" ]; then
    exec "${SCRIPT_DIR}/mcp-gateway-adapter" "$@"
fi
if [ -x "${ROOT_DIR}/bin/mcp-gateway-adapter" ]; then
    exec "${ROOT_DIR}/bin/mcp-gateway-adapter" "$@"
fi

echo "ERROR: MCP Gateway Go binary not found or not executable" >&2
exit 127
