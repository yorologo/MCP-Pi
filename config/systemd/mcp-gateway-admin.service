[Unit]
Description=MCP Gateway Admin Console
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
User=mcp-gateway
Group=mcp-gateway
WorkingDirectory=/home/mcp-gateway/mcp-gateway
Environment=MCP_GATEWAY_REGISTRY=sqlite
Environment=MCP_GATEWAY_DB=/home/mcp-gateway/.local/share/mcp-gateway/gateway.db
Environment=MCP_ADMIN_SECRET_FILE=/home/mcp-gateway/.config/mcp-gateway/admin-secret
Environment=MCP_ADMIN_ALLOWED_HOSTS=127.0.0.1,localhost,mcp-pi
EnvironmentFile=-/home/mcp-gateway/.config/mcp-gateway/admin.env
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ExecStart=/home/mcp-gateway/mcp-gateway/bin/mcp-gateway serve-admin
Restart=on-failure
RestartSec=5
PrivateTmp=true
RestrictRealtime=true
LockPersonality=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/mcp-gateway/.local/share/mcp-gateway /home/mcp-gateway/.config/mcp-gateway
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
