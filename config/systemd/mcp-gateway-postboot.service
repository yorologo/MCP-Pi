[Unit]
Description=MCP Gateway Post-Boot Health Verification
After=mcp-gateway-mcp.service mcp-gateway-admin.service
Wants=mcp-gateway-mcp.service

[Service]
Type=oneshot
User=mcp-gateway
Group=mcp-gateway
WorkingDirectory=/home/mcp-gateway/mcp-gateway
Environment=MCP_GATEWAY_REGISTRY=sqlite
Environment=MCP_GATEWAY_DB=/home/mcp-gateway/.local/share/mcp-gateway/gateway.db
ExecStartPre=/bin/sleep 5
ExecStart=/home/mcp-gateway/mcp-gateway/bin/mcp-gateway doctor
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
