[Unit]
PartOf=mcp-gateway.target
Description=MCP Gateway Gemini MCP Adapter (Streamable HTTP)
After=network.target mcp-gateway-admin.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
User=mcp-gateway
Group=mcp-gateway
WorkingDirectory=/home/mcp-gateway/mcp-gateway
ExecCondition=/usr/bin/test -s /home/mcp-gateway/.config/mcp-gateway/gemini-mcp.token
ExecStart=/home/mcp-gateway/mcp-gateway/bin/mcp-gateway serve-mcp -transport http -bind 0.0.0.0:8092 -auth-token-file /home/mcp-gateway/.config/mcp-gateway/gemini-mcp.token -client-id gemini-main -allowed-hosts gemini-mcp.internal
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
RestrictRealtime=true
LockPersonality=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/mcp-gateway/.local/share/mcp-gateway
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=mcp-gateway.target
