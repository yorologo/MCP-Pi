[Unit]
PartOf=mcp-gateway.target
Description=MCP-Pi Secure MCP Tunnel to OpenAI
Documentation=https://github.com/openai/tunnel-client
After=network-online.target mcp-gateway-mcp.service
Wants=network-online.target
Requires=mcp-gateway-mcp.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=mcp-gateway
Group=mcp-gateway
EnvironmentFile=/home/mcp-gateway/.config/mcp-gateway/tunnel.env
ExecCondition=/usr/local/bin/mcp-gateway-tunnel-check credentials
ExecStartPre=/usr/local/bin/mcp-gateway-tunnel-check backend
ExecStart=/usr/local/bin/openai-tunnel-client run
Restart=always
RestartSec=15s
RestartPreventExitStatus=2
TimeoutStartSec=180s
LimitNOFILE=4096
RestrictRealtime=true
LockPersonality=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=mcp-gateway.target
