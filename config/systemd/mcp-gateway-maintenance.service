[Unit]
Description=MCP Gateway Scheduled Safe Maintenance
After=network.target mcp-gateway-mcp.service

[Service]
Type=oneshot
User=mcp-gateway
Group=mcp-gateway
NoNewPrivileges=yes
PrivateTmp=yes
RestrictRealtime=yes
LockPersonality=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/mcp-gateway/.local/share/mcp-gateway
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
WorkingDirectory=/home/mcp-gateway/mcp-gateway
Environment=MCP_GATEWAY_REGISTRY=sqlite
Environment=MCP_GATEWAY_DB=/home/mcp-gateway/.local/share/mcp-gateway/gateway.db
ExecStart=/home/mcp-gateway/mcp-gateway/bin/mcp-gateway maintenance
