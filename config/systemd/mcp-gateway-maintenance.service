[Unit]
Description=MCP Gateway Scheduled Safe Maintenance
After=network.target mcp-gateway-mcp.service

[Service]
Type=oneshot
User=mcp-gateway
Group=mcp-gateway
WorkingDirectory=/home/mcp-gateway/mcp-gateway
Environment=MCP_GATEWAY_REGISTRY=sqlite
Environment=MCP_GATEWAY_DB=/home/mcp-gateway/.local/share/mcp-gateway/gateway.db
ExecStart=/bin/sh -c 'mkdir -p /home/mcp-gateway/.local/share/mcp-gateway/logs && /home/mcp-gateway/mcp-gateway/bin/mcp-gateway maintenance >> /home/mcp-gateway/.local/share/mcp-gateway/logs/maintenance.log 2>&1'
