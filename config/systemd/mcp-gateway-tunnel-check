#!/bin/bash
# MCP Gateway Secure MCP Tunnel Preflight Check & Backend Readiness Wait
# Ensures credentials are configured and backend MCP is actively ready before starting tunnel daemon.

set -u

check_credentials() {
    if [ -z "${CONTROL_PLANE_TUNNEL_ID:-}" ] || [ -z "${CONTROL_PLANE_API_KEY:-}" ]; then
        echo "OpenAI Tunnel credentials not configured (CONTROL_PLANE_TUNNEL_ID/CONTROL_PLANE_API_KEY empty): state is OPENAI_PRODUCT_GATE_PENDING" >&2
        return 2
    fi
    return 0
}

wait_backend() {
    BACKEND_URL="${MCP_BACKEND_URL:-http://127.0.0.1:8090/ready}"
    TIMEOUT_SECS="${MCP_BACKEND_TIMEOUT_SECS:-120}"
    POLL_INTERVAL="${MCP_BACKEND_POLL_INTERVAL:-1}"

    start_time=$SECONDS
    last_status=""

    while true; do
        status=$(curl -s -m 2 -o /dev/null -w "%{http_code}" "$BACKEND_URL" 2>/dev/null) || true
        [ -z "$status" ] && status="000"
        if [ "$status" = "200" ]; then
            return 0
        fi
        last_status="$status"

        elapsed=$((SECONDS - start_time))
        if [ "$elapsed" -ge "$TIMEOUT_SECS" ]; then
            echo "MCP backend at $BACKEND_URL not ready after ${elapsed}s (last HTTP status: ${last_status}): state is MCP_BACKEND_NOT_READY_TIMEOUT" >&2
            return 1
        fi

        sleep "$POLL_INTERVAL"
    done
}

mode="${1:-all}"

case "$mode" in
    credentials)
        check_credentials || exit $?
        exit 0
        ;;
    backend)
        wait_backend || exit $?
        exit 0
        ;;
    all)
        check_credentials || exit $?
        wait_backend || exit $?
        exit 0
        ;;
    *)
        echo "Usage: $0 [credentials|backend|all]" >&2
        exit 1
        ;;
esac
